# =============================================================================
# Docker Ignore File - Exclude from build context
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.env
*.egg-info/
.eggs/
dist/
build/

# Node.js
node_modules/
ui/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# UI build (we build inside Docker)
ui/dist/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Database files (recreated at runtime)
*.db
*.db-journal

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Documentation (not needed in container)
docs/
*.md
!README.md

# Shell scripts (not needed in container)
*.sh
*.bat

# Development files
.env.example
.env.local
SAMPLE_PROMPT.md
