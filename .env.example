# GLM / Z.AI API Configuration
# Z.AI API Key (required for GLM model support)
# Get your key from: https://api.z.ai/
ZAI_API_KEY=your-api-key-here

# Alternative: Use Anthropic API key directly (if not using GLM proxy)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: N8N webhook for progress notifications
# PROGRESS_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/...
