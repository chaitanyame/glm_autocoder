# =============================================================================
# AutoCoder Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Z.AI API Key
# =============================================================================
# Get your key from: https://api.z.ai/
# This key is used for all AI model interactions (GLM 4.7, GLM 4.5 Air)
ZAI_API_KEY=your-api-key-here

# =============================================================================
# REQUIRED (Docker): Projects Directory
# =============================================================================
# Absolute path to the folder where generated projects will be stored.
# This folder is mounted into the Docker container at /projects.
# 
# Windows example:
#   PROJECTS_DIR=C:/Users/YourName/Documents/autocoder_projects
#
# Mac/Linux example:
#   PROJECTS_DIR=/home/yourname/autocoder_projects
#
# The path you set here will be shown in the UI for easy VS Code access.
PROJECTS_DIR=./autocoder_projects

# =============================================================================
# OPTIONAL: N8N Webhook for Progress Notifications
# =============================================================================
# Uncomment to receive webhook notifications when features pass/fail
# PROGRESS_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/...
